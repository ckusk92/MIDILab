<Window x:Class="MIDILab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIDILab" Height="740" Width="1140" MinHeight="620" MinWidth="900"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource WindowForegroundBrush}">
    <Window.Resources>
        <!-- MIDILab theme tokens. MainWindow.xaml.cs swaps these brushes for dark mode. -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF2F5FA"/>
        <SolidColorBrush x:Key="WindowForegroundBrush" Color="#FF1D2433"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFBFCFE"/>
        <SolidColorBrush x:Key="ControlForegroundBrush" Color="#FF1D2433"/>
        <SolidColorBrush x:Key="BorderBrushTheme" Color="#FFD8DEE9"/>
        <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#FFF7F9FC"/>
        <SolidColorBrush x:Key="StatusForegroundBrush" Color="#FF667085"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF5865F2"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF4752D6"/>
        <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFEEF0FF"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FFF0F3F8"/>
        <SolidColorBrush x:Key="EditorHeaderBrush" Color="#FFF0F2FF"/>
        <SolidColorBrush x:Key="EditorLabelBrush" Color="#FFF7F8FC"/>
        <SolidColorBrush x:Key="EditorGridLineBrush" Color="#FFDDE2EA"/>
        <SolidColorBrush x:Key="EditorStrongLineBrush" Color="#FFA7B0C0"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource StatusForegroundBrush}"/>
            <Setter Property="Margin" Value="1,0,0,6"/>
        </Style>

        <Style x:Key="SettingsFieldStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,18,0"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTheme}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTheme}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                CornerRadius="8"
                                                Background="{DynamicResource ControlBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrushTheme}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="9,0,5,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{DynamicResource ControlForegroundBrush}"/>
                                                <Border Grid.Column="1" Background="Transparent">
                                                    <Path Width="8" Height="5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="{DynamicResource ControlForegroundBrush}"
                                                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource ControlBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrushTheme}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTheme}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxBorder"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,20">
        <DockPanel MaxWidth="1280" HorizontalAlignment="Center">
            <!-- Application title -->
            <Grid DockPanel.Dock="Top" Margin="2,0,2,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MIDILab" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Drum MIDI Generator" Margin="1,3,0,0" FontSize="13"
                               Foreground="{DynamicResource StatusForegroundBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenProjectButton" Content="Open Project..." Height="34" Padding="12,0" Margin="0,0,8,0"
                            Click="OpenProjectButton_Click" ToolTip="Open a saved MIDILab project, including its editable pattern and settings."/>
                    <Button x:Name="SaveProjectButton" Content="Save Project..." Height="34" Padding="12,0" Margin="0,0,12,0"
                            Click="SaveProjectButton_Click" ToolTip="Save the current editable pattern and MIDILab settings."/>
                    <Button x:Name="HelpButton" Content="? Settings Guide" Height="34" Padding="12,0" Margin="0,0,12,0"
                            Click="HelpButton_Click" ToolTip="Show or hide descriptions of the generation controls."/>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="Theme" Style="{StaticResource FieldLabelStyle}" Margin="1,0,0,3"/>
                        <ComboBox x:Name="ThemeComboBox" Width="105" MinHeight="32" SelectedIndex="0"
                                  ToolTip="Choose MIDILab's accent color theme. Dark Mode can be combined with any theme.">
                            <ComboBoxItem Content="Indigo"/>
                            <ComboBoxItem Content="Ocean"/>
                            <ComboBoxItem Content="Emerald"/>
                            <ComboBoxItem Content="Amber"/>
                            <ComboBoxItem Content="Rose"/>
                            <ComboBoxItem Content="Slate"/>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="DarkModeCheckBox" Content="Dark Mode"
                              Checked="DarkModeCheckBox_Changed" Unchecked="DarkModeCheckBox_Changed"
                              ToolTip="Switch between light and dark appearance while keeping the selected color theme."/>
                </StackPanel>
            </Grid>

            <!-- Settings -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Text="Settings" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,9"/>
                <Border Padding="18,16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrushTheme}"
                        Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="14">
                    <StackPanel>
                        <!-- Row 1: song / generation structure -->
                        <WrapPanel Margin="0,0,0,16">
                            <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                <TextBlock Text="BPM" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="BpmTextBox" Text="120" Width="78" VerticalContentAlignment="Center"
                                         ToolTip="Playback tempo in beats per minute. Higher BPM makes the groove play faster."/>
                            </StackPanel>

                            <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                <TextBlock Text="Bars" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="BarsComboBox" SelectedIndex="1" Width="78"
                                          ToolTip="How many bars MIDILab should generate in the selected time signature.">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="16"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                <TextBlock Text="Time Signature" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="TimeSignatureComboBox" SelectedIndex="0" Width="110"
                                          SelectionChanged="TimeSignatureComboBox_SelectionChanged"
                                          ToolTip="Sets the musical meter. 4/4 is the default; 3/4, 6/8, 5/4 and 7/8 are also supported.">
                                    <ComboBoxItem Content="4/4"/>
                                    <ComboBoxItem Content="3/4"/>
                                    <ComboBoxItem Content="6/8"/>
                                    <ComboBoxItem Content="5/4"/>
                                    <ComboBoxItem Content="7/8"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="GroupingPanel" Style="{StaticResource SettingsFieldStyle}" Visibility="Collapsed">
                                <TextBlock Text="Grouping" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="GroupingComboBox" Width="110"
                                          ToolTip="For odd meters, chooses which beats are grouped together and emphasized."/>
                            </StackPanel>

                            <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                <TextBlock Text="Genre" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="GenreComboBox" SelectedIndex="0" Width="120"
                                          ToolTip="Changes the musical rules used to generate the groove, not just the drum sounds.">
                                    <ComboBoxItem Content="Rock"/>
                                    <ComboBoxItem Content="Indie"/>
                                    <ComboBoxItem Content="Folk"/>
                                    <ComboBoxItem Content="Metal"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                <TextBlock Text="Section" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="SectionComboBox" SelectedIndex="0" Width="132"
                                          ToolTip="Shapes the generated groove for a song role. General preserves the normal generator behavior.">
                                    <ComboBoxItem Content="General"/>
                                    <ComboBoxItem Content="Intro"/>
                                    <ComboBoxItem Content="Verse"/>
                                    <ComboBoxItem Content="Pre-Chorus"/>
                                    <ComboBoxItem Content="Chorus"/>
                                    <ComboBoxItem Content="Bridge"/>
                                    <ComboBoxItem Content="Breakdown"/>
                                    <ComboBoxItem Content="Outro"/>
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>

                        <Border Height="1" Background="{DynamicResource BorderBrushTheme}" Margin="0,0,0,15"/>

                        <!-- Row 2: kit / sound / feel -->
                        <WrapPanel>
                            <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                <TextBlock Text="Kit" Style="{StaticResource FieldLabelStyle}"/>
                                <Button x:Name="CustomizeKitButton" Content="Customize Kit" Height="34" Padding="12,0"
                                        Style="{StaticResource AccentOutlineButtonStyle}"
                                        Click="CustomizeKitButton_Click"
                                        ToolTip="Choose which drum and percussion pieces appear in the editor and can be used by the generator."/>
                            </StackPanel>

                            <StackPanel Style="{StaticResource SettingsFieldStyle}">
                                <TextBlock Text="Export Target" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="OutputProfileComboBox" SelectedIndex="0" Width="250"
                                          SelectionChanged="OutputProfileComboBox_SelectionChanged"
                                          ToolTip="Chooses the MIDI drum map used when exporting. General MIDI is the default.">
                                    <ComboBoxItem Content="General MIDI"/>
                                    <ComboBoxItem Content="Steven Slate Drums 5.5 - Factory Map"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Style="{StaticResource SettingsFieldStyle}" Width="190">
                                <TextBlock Text="Energy" Style="{StaticResource FieldLabelStyle}"/>
                                <Slider x:Name="EnergySlider" Minimum="0" Maximum="100" Value="55"
                                        TickFrequency="10" Width="180" HorizontalAlignment="Left"
                                        ToolTip="Controls how active and forceful the generated performance is: denser kick/cymbal activity, stronger accents and more fills at higher values."/>
                            </StackPanel>

                            <StackPanel Style="{StaticResource SettingsFieldStyle}" Width="190">
                                <TextBlock Text="Humanize" Style="{StaticResource FieldLabelStyle}"/>
                                <Slider x:Name="HumanizeSlider" Minimum="0" Maximum="100" Value="45"
                                        TickFrequency="10" Width="180" HorizontalAlignment="Left"
                                        ToolTip="Adds controlled velocity and timing variation so the performance sounds less mechanically quantized."/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="KitSettingsBorder" Visibility="Collapsed" Margin="0,9,0,0" Padding="15"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrushTheme}" CornerRadius="12"
                        Background="{DynamicResource SubtleBackgroundBrush}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Customize Kit" FontWeight="Bold" FontSize="15"/>
                                <TextBlock x:Name="KitProfileHintTextBlock"
                                           Text="The original nine pieces are selected by default. Availability and exported MIDI notes follow the selected Export Target."
                                           Foreground="{DynamicResource StatusForegroundBrush}" Margin="0,3,12,0"/>
                            </StackPanel>
                            <Button x:Name="ResetKitButton" Content="Reset Default Kit" DockPanel.Dock="Right"
                                    HorizontalAlignment="Right" Padding="12,5" Click="ResetKitButton_Click"/>
                        </DockPanel>
                        <WrapPanel x:Name="KitOptionsPanel"/>
                        <TextBlock Text="MIDILab generates musical instrument roles first, then translates them through the selected export profile. Added pieces can always be edited manually; the generator uses suitable extras sparingly based on genre, section, and energy."
                                   TextWrapping="Wrap" Foreground="{DynamicResource StatusForegroundBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SettingsGuideBorder" Visibility="Collapsed" Margin="0,9,0,0" Padding="14"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrushTheme}" CornerRadius="12"
                        Background="{DynamicResource SubtleBackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="Settings Guide" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Run FontWeight="Bold" Text="BPM: "/><Run Text="Sets playback/export tempo. 120 BPM means two beats per second."/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Run FontWeight="Bold" Text="Bars: "/><Run Text="Sets the number of measures. The number of grid steps in each bar automatically changes with the selected time signature."/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Run FontWeight="Bold" Text="Time Signature: "/><Run Text="Controls the meter and bar length. 4/4 is the default. 3/4 has three quarter-note beats; 6/8 is naturally grouped 3+3; 5/4 and 7/8 expose a Grouping option so the generator can emphasize the chosen internal pulse."/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Run FontWeight="Bold" Text="Grouping: "/><Run Text="For odd meters, tells MIDILab where the strong internal divisions fall. For example, 7/8 can feel like 2+2+3, 2+3+2 or 3+2+2."/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Run FontWeight="Bold" Text="Genre: "/><Run Text="Changes the generator's musical tendencies. Rock is balanced and conventional; Indie favors syncopation and variation; Folk stays lighter and simpler; Metal favors denser kick/cymbal activity and stronger fills."/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Run FontWeight="Bold" Text="Section: "/><Run Text="Shapes the groove for its role in a song. General keeps the standard behavior; Intro and Verse are more restrained, Pre-Chorus builds, Chorus opens up, Bridge changes orchestration, Breakdown gets sparse, and Outro emphasizes the ending."/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Run FontWeight="Bold" Text="Export Target: "/><Run Text="Chooses the drum map used when the MIDI file is written. General MIDI is the default. Steven Slate Drums 5.5 - Factory Map translates MIDILab pieces to SSD5.5 factory articulation notes. Preview still uses the Windows General MIDI synth, so its basic sound does not change with this setting."/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Run FontWeight="Bold" Text="Energy: "/><Run Text="Controls activity and intensity. Higher settings can add busier kick patterns, stronger cymbal use, louder accents and more fill activity."/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Run FontWeight="Bold" Text="Humanize: "/><Run Text="Adds controlled timing and velocity variation. Low values are tighter and more machine-like; higher values are looser and more dynamic."/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Run FontWeight="Bold" Text="Customize Kit: "/><Run Text="Choose which drum/percussion rows are available. The default kit matches earlier MIDILab versions. Disabled pieces are excluded from new generations; optional pieces such as China, Splash, Tambourine, Cowbell, Clap and extra toms can be enabled."/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Run FontWeight="Bold" Text="Generate / New Variation / Reset Edits: "/><Run Text="Generate creates a new starting groove. New Variation creates another take using the same settings. Reset Edits returns to the exact most-recent generated take after manual grid edits."/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Run FontWeight="Bold" Text="Pattern editing: "/><Run Text="Left-click a pad to add or remove a hit. Active pads are shaded by MIDI velocity: softer hits are lighter and harder hits are stronger. Right-click an active pad to edit its exact velocity and timing offset."/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                            <Run FontWeight="Bold" Text="Projects: "/><Run Text="Save Project stores the editable drum pattern, generated reset baseline, generation settings, kit, export target, and appearance in a .midilab file. Open Project restores them later."/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap">
                            <Run FontWeight="Bold" Text="Theme: "/><Run Text="Choose one of six accent themes. Theme and Dark Mode only affect MIDILab's appearance and do not change the generated MIDI."/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Action / status bar -->
            <Border DockPanel.Dock="Bottom" Margin="0,14,0,0" Padding="12"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrushTheme}"
                    Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="12">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}" x:Name="GenerateButton" Content="Generate" Width="100" Height="38" Margin="0,0,8,0"
                                Click="GenerateButton_Click"/>
                        <Button x:Name="VariationButton" Content="New Variation" Width="120" Height="38" Margin="0,0,8,0"
                                Click="VariationButton_Click" IsEnabled="False"/>
                        <Button x:Name="ResetButton" Content="Reset Edits" Width="105" Height="38" Margin="0,0,14,0"
                                Click="ResetButton_Click" IsEnabled="False"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" x:Name="PlayButton" Content="▶ Play" Width="82" Height="38" Margin="0,0,8,0"
                                Click="PlayButton_Click"/>
                        <Button x:Name="StopButton" Content="■ Stop" Width="82" Height="38" Margin="0,0,14,0"
                                Click="StopButton_Click" IsEnabled="False"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" x:Name="ExportButton" Content="Export MIDI..." Width="120" Height="38" Margin="0,0,14,0"
                                Click="ExportButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource StatusForegroundBrush}">
                        Set your parameters, then click Generate.
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- Editor -->
            <StackPanel>
                <Grid Margin="2,0,2,8">
                    <TextBlock Text="Pattern Editor" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                    <TextBlock Text="Color intensity = velocity  •  Left-click add/remove  •  Drag active hit to move  •  Right-click to edit" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource StatusForegroundBrush}"/>
                </Grid>

                <Border x:Name="HitEditorBorder" Visibility="Collapsed" Margin="0,0,0,9" Padding="14,11"
                        BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" CornerRadius="12"
                        Background="{DynamicResource AccentSoftBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="145">
                            <TextBlock x:Name="HitEditorTitleTextBlock" Text="Edit Hit" FontWeight="Bold" FontSize="14"/>
                            <TextBlock x:Name="HitEditorPositionTextBlock" Margin="0,2,0,0" FontSize="11"
                                       Foreground="{DynamicResource StatusForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Velocity" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                                <TextBlock x:Name="VelocityValueTextBlock" Text="100" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            </DockPanel>
                            <Slider x:Name="HitVelocitySlider" Minimum="1" Maximum="127" Value="100" TickFrequency="1"
                                    ValueChanged="HitVelocitySlider_ValueChanged"
                                    ToolTip="MIDI velocity from 1 (very soft) to 127 (maximum)."/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <TextBlock Text="Timing offset (ticks)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="HitTimingTextBox" Text="0" Width="145" HorizontalAlignment="Left"
                                     ToolTip="Move this hit slightly early (negative) or late (positive). Allowed range: -60 to +60 MIDI ticks."/>
                        </StackPanel>

                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}" Padding="13,6" Margin="0,0,7,0"
                                    Click="ApplyHitEditButton_Click"/>
                            <Button Content="Remove" Padding="11,6" Margin="0,0,7,0" Click="RemoveHitEditButton_Click"/>
                            <Button Content="Cancel" Padding="11,6" Click="CancelHitEditButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrushTheme}" Background="{DynamicResource PanelBackgroundBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="12">
                    <ScrollViewer x:Name="DrumScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="EditorGrid"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
